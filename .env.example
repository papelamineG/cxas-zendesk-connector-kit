# ==============================================================================
# CXAS Zendesk Connector Kit — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Cloud & CX Agent Studio Configuration
# ------------------------------------------------------------------------------
# Target Google Cloud Project ID hosting Cloud Run and Secret Manager
GCP_PROJECT_ID="your-gcp-project-id"

# GCP Region for Cloud Run deployment and Secret Manager
GCP_REGION="us-central1"

# CX Agent Studio location (default 'us' in scripts/setup_cxas.py and Makefile)
CXAS_LOCATION="us"

# CX Agent Studio App UUID (from CX Agent Studio console URL or gcloud ces apps list)
CXAS_APP_ID="your-cxas-app-uuid"

# Display brand name for the chat interface and support communications
APP_BRAND="Acme Support"

# Server Port (Cloud Run injects PORT; defaults to 8080 locally)
PORT=8080

# ------------------------------------------------------------------------------
# Zendesk Integration Configuration
# ------------------------------------------------------------------------------
# If true (or if ZENDESK_API_TOKEN is empty), runs the backend against the built-in
# MockZendesk v2 sandbox emulator. Set ZENDESK_MOCK_MODE=false to enforce live mode
# (missing credentials will then fail loudly with ZENDESK_NOT_CONFIGURED).
ZENDESK_MOCK_MODE=false

# Zendesk subdomain (e.g., 'acmesupport' for acmesupport.zendesk.com)
ZENDESK_SUBDOMAIN="your-subdomain"

# Zendesk agent or admin email address
ZENDESK_EMAIL="agent@example.com"

# Zendesk API Token (generated under Admin Center -> Apps and integrations -> Zendesk API)
# In production on Cloud Run, this is stored securely in Secret Manager as 'zendesk-api-token'.
ZENDESK_API_TOKEN="your-zendesk-api-token"

# Priority assigned to newly opened live-escalation tickets (low | normal | high | urgent)
ZENDESK_ESCALATION_PRIORITY="urgent"

# HTTP request timeout in seconds for Zendesk API v2 calls
ZENDESK_TIMEOUT_S=15

# Allow the specialist simulator endpoints (/api/simulator/...) in live Zendesk mode
ALLOW_LIVE_SIMULATOR=false

# ------------------------------------------------------------------------------
# Server CORS & MCP Transport Security Settings
# ------------------------------------------------------------------------------
# Comma-separated list of allowed CORS origins for browser requests (default: *)
CORS_ALLOW_ORIGINS="*"

# Optional comma-separated Host header allowlist for FastMCP DNS-rebinding protection
MCP_ALLOWED_HOSTS=""
MCP_ALLOWED_ORIGINS=""
